<?xml version="1.0"?>
<!-- Generated from xacro 73861412-b24f-4681-98ec-6b114fffab56.xacro (ROS2 Foxy) -->
<robot name="opp_racecar">
  <!-- Materials -->
  <material name="black"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="red"><color rgba="1.0 0.57 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 1.0 1.0"/></material>

  <!-- Base -->
  <link name="opp_racecar/base_link">
    <visual>
      <origin xyz="0 0 0.090000" rpy="0 0 0"/>
      <geometry><box size="0.51 0.28 0.1"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Laser -->
  <link name="opp_racecar/laser_model">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.026" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_laser_model" type="fixed">
    <parent link="opp_racecar/base_link"/>
    <child link="opp_racecar/laser_model"/>
    <origin xyz="0.115000 0 0.165000" rpy="0 0 0"/>
  </joint>

  <!-- Rear wheels (fixed) -->
  <link name="opp_racecar/back_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796326795 0 0"/>
      <geometry><cylinder radius="0.0508" length="0.0381"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_back_left_wheel" type="fixed">
    <parent link="opp_racecar/base_link"/>
    <child link="opp_racecar/back_left_wheel"/>
    <origin xyz="-0.160000 0.159050 0.050800" rpy="0 0 0"/>
  </joint>

  <link name="opp_racecar/back_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796326795 0 0"/>
      <geometry><cylinder radius="0.0508" length="0.0381"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_back_right_wheel" type="fixed">
    <parent link="opp_racecar/base_link"/>
    <child link="opp_racecar/back_right_wheel"/>
    <origin xyz="-0.160000 -0.159050 0.050800" rpy="0 0 0"/>
  </joint>

  <!-- Front hinges (fixed) -->
  <link name="opp_racecar/front_left_hinge"/>
  <joint name="base_to_front_left_hinge" type="fixed">
    <parent link="opp_racecar/base_link"/>
    <child link="opp_racecar/front_left_hinge"/>
    <origin xyz="0.160000 0.159050 0.050800" rpy="0 0 0"/>
  </joint>

  <link name="opp_racecar/front_right_hinge"/>
  <joint name="base_to_front_right_hinge" type="fixed">
    <parent link="opp_racecar/base_link"/>
    <child link="opp_racecar/front_right_hinge"/>
    <origin xyz="0.160000 -0.159050 0.050800" rpy="0 0 0"/>
  </joint>

  <!-- Front wheels (continuous, with explicit axis) -->
  <link name="opp_racecar/front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796326795 0 0"/>
      <geometry><cylinder radius="0.0508" length="0.0381"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="front_left_hinge_to_wheel" type="continuous">
    <parent link="opp_racecar/front_left_hinge"/>
    <child link="opp_racecar/front_left_wheel"/>
    <!-- Wheel spin axis (y) -->
    <axis xyz="0 1 0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="opp_racecar/front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796326795 0 0"/>
      <geometry><cylinder radius="0.0508" length="0.0381"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="front_right_hinge_to_wheel" type="continuous">
    <parent link="opp_racecar/front_right_hinge"/>
    <child link="opp_racecar/front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
